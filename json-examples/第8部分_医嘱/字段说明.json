        {"path": "controlActProcess.subject.order.components[].effectiveTime", "name": "有效期间", "type": "object", "required": false, "description": "医嘱开始/结束时间"},
        {"path": "controlActProcess.subject.order.components[].routeCode", "name": "用药途径", "type": "string", "required": false, "dataElement": "DE06.00.134.00", "description": "药物使用途径"},
        {"path": "controlActProcess.subject.order.components[].doseQuantity", "name": "次剂量", "type": "object", "required": false, "dataElement": "DE08.50.023.00", "description": "每次用药剂量"},
        {"path": "controlActProcess.subject.order.components[].medication.name", "name": "药物名称", "type": "string", "required": false, "dataElement": "DE08.50.022.00", "description": "药物名称"},
        {"path": "controlActProcess.subject.order.components[].location.id.item", "name": "执行科室", "type": "string", "required": false, "oidRoot": "2.16.156.10011.1.26", "description": "执行科室编码"},
