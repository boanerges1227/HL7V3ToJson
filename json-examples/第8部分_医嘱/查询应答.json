{
  "messageHeader": {
    "_description": "消息头信息",
    "id": {
      "_description": "消息流水号",
      "_cardinality": "1..1",
      "_required": true,
      "_format": "字符串，最大长度50",
      "root": { "_value": "2.16.156.10011.2.5.1.1" },
      "extension": { "_description": "查询应答消息流水号" }
    },
    "creationTime": {
      "_description": "消息创建时间",
      "_cardinality": "1..1",
      "_required": true,
      "_format": "yyyyMMddHHmmss"
    },
    "interactionId": {
      "_description": "消息服务标识",
      "root": { "_value": "2.16.156.10011.2.5.1.2" },
      "extension": {
        "_description": "固定值 QUMT_IN020040UV01 表示医嘱查询应答"
      }
    },
    "processingCode": { "_description": "处理代码" },
    "acceptAckCode": { "_description": "消息应答控制码" },
    "receiver": {
      "_description": "接收者信息（原查询请求方）",
      "device": {
        "id": {
          "item": {
            "root": { "_value": "2.16.156.10011.2.5.1.3" },
            "extension": { "_description": "原查询请求方系统标识" }
          }
        }
      }
    },
    "sender": {
      "_description": "发送者信息（查询服务提供方）",
      "device": {
        "id": {
          "item": {
            "root": { "_value": "2.16.156.10011.2.5.1.3" },
            "extension": { "_description": "查询服务提供方系统标识" }
          }
        }
      }
    }
  },
  "acknowledgement": {
    "_description": "应答状态信息",
    "typeCode": {
      "_description": "处理结果类型码",
      "_cardinality": "1..1",
      "_required": true,
      "_allowedValues": {
        "AA": "查询成功",
        "AE": "查询失败",
        "AR": "查询被拒绝"
      }
    },
    "targetMessage": {
      "_description": "被应答的原始查询请求引用",
      "id": {
        "root": { "_value": "2.16.156.10011.2.5.1.1" },
        "extension": { "_description": "原始查询请求的消息流水号" }
      }
    },
    "detail": {
      "_description": "应答详细信息",
      "text": {
        "_description": "处理结果说明",
        "_format": "字符串，最大长度200"
      }
    }
  },
  "queryResponse": {
    "_description": "查询结果信息",
    "queryId": {
      "_description": "查询流水号，与请求消息中的消息流水号对应"
    },
    "responseCode": {
      "_description": "查询响应代码",
      "_allowedValues": {
        "OK": "找到数据",
        "NF": "未找到数据",
        "QE": "查询参数错误",
        "AE": "系统错误"
      }
    }
  },
  "order": {
    "_description": "医嘱信息（查询结果包含的医嘱详情，结构与开立请求中的order相同）",
    "author": {
      "_description": "医嘱开立信息",
      "time": { "_description": "医嘱开立日期时间" },
      "signatureCode": { "_description": "签名编码" },
      "signatureText": { "_description": "开立医师签名" },
      "assignedEntity": {
        "_description": "开立医护人员信息",
        "id": { "_description": "医护人员工号" },
        "person": { "_description": "医护人员姓名" },
        "organization": { "_description": "开立科室信息" }
      }
    },
    "verifier": {
      "_description": "医嘱审核信息",
      "time": { "_description": "审核日期时间" },
      "signatureCode": { "_description": "签名编码" },
      "signatureText": { "_description": "审核医师签名" },
      "assignedEntity": {
        "_description": "审核医护人员信息"
      }
    },
    "components": {
      "_description": "医嘱项目列表",
      "_cardinality": "1..*",
      "sequenceNumber": { "_description": "医嘱序号" },
      "substanceAdministration": {
        "_description": "药品医嘱详情",
        "id": { "_description": "医嘱编号" },
        "code": { "_description": "医嘱项目类型" },
        "text": { "_description": "医嘱内容" },
        "statusCode": { "_description": "医嘱状态" },
        "effectiveTime": { "_description": "医嘱有效期间/执行频率" },
        "routeCode": { "_description": "用药途径" },
        "doseQuantity": { "_description": "次剂量" },
        "medication": { "_description": "药物信息" },
        "location": { "_description": "执行科室" },
        "orderCategory": { "_description": "医嘱类别" },
        "annotation": { "_description": "医嘱备注" }
      }
    },
    "encounter": {
      "_description": "就诊信息",
      "visitNumber": { "_description": "就诊次数" },
      "encounterId": { "_description": "就诊流水号" },
      "patientType": { "_description": "患者类型" },
      "patient": { "_description": "患者信息" },
      "location": { "_description": "住院位置信息" }
    }
  }
}
