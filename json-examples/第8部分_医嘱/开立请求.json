          "POOR_IN200902UV - 医嘱信息更新请求",
          "QUMT_IN020030UV01 - 医嘱信息查询请求",
          "QUMT_IN020040UV01 - 医嘱信息查询应答",
          "MCCI_IN000002UV01 - 通用应答消息"
