{
  "messageHeader": {
    "_description": "消息头信息",
    "id": {
      "_description": "消息流水号，唯一标识本条应答消息",
      "_cardinality": "1..1",
      "_required": true,
      "_format": "字符串，最大长度50",
      "root": {
        "_description": "固定值，标识ID类型为消息流水号",
        "_value": "2.16.156.10011.2.5.1.1"
      },
      "extension": {
        "_description": "应答消息的流水号"
      }
    },
    "creationTime": {
      "_description": "消息创建时间",
      "_cardinality": "1..1",
      "_required": true,
      "_format": "日期时间格式，yyyyMMddHHmmss（DT15）"
    },
    "interactionId": {
      "_description": "消息服务标识",
      "_cardinality": "1..1",
      "_required": true,
      "root": {
        "_value": "2.16.156.10011.2.5.1.2"
      },
      "extension": {
        "_description": "固定值 MCCI_IN000002UV01 表示通用应答消息"
      }
    },
    "processingCode": {
      "_description": "处理代码",
      "_allowedValues": { "D": "调试", "P": "产品", "T": "训练" }
    },
    "processingModeCode": {
      "_description": "处理模型代码",
      "_cardinality": "0..1",
      "_required": false
    },
    "acceptAckCode": {
      "_description": "消息应答控制码"
    },
    "receiver": {
      "_description": "接收者信息（应答消息的接收方即原请求的发送方）",
      "typeCode": {
        "_description": "固定值，表示接收方",
        "_value": "RCV"
      },
      "device": {
        "classCode": {
          "_value": "DEV"
        },
        "determinerCode": {
          "_value": "INSTANCE"
        },
        "id": {
          "item": {
            "root": { "_value": "2.16.156.10011.2.5.1.3" },
            "extension": { "_description": "原请求发送系统标识" }
          }
        }
      }
    },
    "sender": {
      "_description": "发送者信息（应答消息的发送方即原请求的接收方）",
      "typeCode": {
        "_description": "固定值，表示发送方",
        "_value": "SND"
      },
      "device": {
        "classCode": {
          "_value": "DEV"
        },
        "determinerCode": {
          "_value": "INSTANCE"
        },
        "id": {
          "item": {
            "root": { "_value": "2.16.156.10011.2.5.1.3" },
            "extension": { "_description": "原请求接收系统标识" }
          }
        }
      }
    }
  },
  "acknowledgement": {
    "_description": "应答信息主体",
    "typeCode": {
      "_description": "处理结果类型码",
      "_cardinality": "1..1",
      "_required": true,
      "_allowedValues": {
        "AA": "接受成功（Accept Acknowledgement）",
        "AE": "接受失败（Application Error）",
        "AR": "拒绝（Application Reject）"
      }
    },
    "targetMessage": {
      "_description": "被应答的原始请求消息引用",
      "_cardinality": "1..1",
      "_required": true,
      "id": {
        "_description": "原始请求消息的流水号",
        "_cardinality": "1..1",
        "_required": true,
        "_format": "字符串，最大长度50",
        "root": {
          "_description": "固定值",
          "_value": "2.16.156.10011.2.5.1.1"
        },
        "extension": {
          "_description": "被应答的请求消息流水号"
        }
      }
    },
    "acknowledgementDetail": {
      "_description": "应答详细信息",
      "_cardinality": "1..1",
      "_required": true,
      "text": {
        "_description": "处理结果说明",
        "_cardinality": "1..1",
        "_required": true,
        "_format": "字符串，最大长度200"
      }
    }
  }
}
