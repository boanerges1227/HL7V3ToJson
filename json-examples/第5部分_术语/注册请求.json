{
  "messageHeader": {
    "_description": "消息头信息，所有消息类型的公共部分",
    "id": {
      "_description": "消息流水号，唯一标识本条消息",
      "_cardinality": "1..1",
      "_required": true,
      "_format": "字符串，最大长度50",
      "root": {
        "_description": "固定值，标识ID类型为消息流水号",
        "_value": "2.16.156.10011.2.5.1.1"
      },
      "extension": {
        "_description": "消息流水号的具体值，由发送方生成的唯一标识",
        "_example": "22a0f9e0-4454-11dc-a6be-3603d6866807"
      }
    },
    "creationTime": {
      "_description": "消息创建时间，标识消息何时生成",
      "_cardinality": "1..1",
      "_required": true,
      "_format": "日期时间格式，yyyyMMddHHmmss（DT15）",
      "_example": "20130501130624"
    },
    "interactionId": {
      "_description": "消息服务标识，标识本消息对应哪个服务接口",
      "_cardinality": "1..1",
      "_required": true,
      "root": {
        "_description": "固定值，标识ID类型为消息服务标识",
        "_value": "2.16.156.10011.2.5.1.2"
      },
      "extension": {
        "_description": "服务标识代码，PRVS_IN000001UV01 表示术语注册请求",
        "_value": "PRVS_IN000001UV01"
      }
    },
    "processingCode": {
      "_description": "处理代码，标识此消息属于哪种系统环境",
      "_cardinality": "1..1",
      "_required": true,
      "_allowedValues": {
        "D": "调试系统（Debug）",
        "P": "产品系统（Production）",
        "T": "训练系统（Training）"
      }
    },
    "processingModeCode": {
      "_description": "处理模型代码，定义此消息是文档处理还是初始装载的一部分",
      "_cardinality": "0..1",
      "_required": false,
      "_allowedValues": {
        "A": "存档（Archive）",
        "I": "初始装载（Initial Load）",
        "R": "从存档中恢复（Restore from Archive）",
        "T": "当前处理，间隔传递（Current Processing）"
      }
    },
    "acceptAckCode": {
      "_description": "消息应答控制码，标识接收方是否需要返回应答",
      "_cardinality": "1..1",
      "_required": true,
      "_allowedValues": {
        "AL": "总是返回应答（Always）",
        "ER": "仅在错误时返回应答（Error/reject only）",
        "NE": "从不返回应答（Never）",
        "SU": "仅在成功完成时返回应答（Success only）"
      }
    },
    "receiver": {
      "_description": "接收者信息，标识消息的目标系统",
      "_cardinality": "1..1",
      "_required": true,
      "typeCode": {
        "_description": "固定值，表示接收方",
        "_value": "RCV"
      },
      "device": {
        "_description": "接收设备/系统信息",
        "classCode": {
          "_description": "固定值，表示设备",
          "_value": "DEV"
        },
        "determinerCode": {
          "_description": "固定值，表示实例",
          "_value": "INSTANCE"
        },
        "id": {
          "_description": "接收系统标识",
          "item": {
            "_description": "系统标识信息",
            "root": {
              "_description": "固定值，标识ID类型为系统标识",
              "_value": "2.16.156.10011.2.5.1.3"
            },
            "extension": {
              "_description": "接收系统的唯一标识编码"
            }
          }
        }
      }
    },
    "sender": {
      "_description": "发送者信息，标识消息的来源系统",
      "_cardinality": "1..1",
      "_required": true,
      "typeCode": {
        "_description": "固定值，表示发送方",
        "_value": "SND"
      },
      "device": {
        "_description": "发送设备/系统信息",
        "classCode": {
          "_description": "固定值，表示设备",
          "_value": "DEV"
        },
        "determinerCode": {
          "_description": "固定值，表示实例",
          "_value": "INSTANCE"
        },
        "id": {
          "_description": "发送系统标识",
          "item": {
            "_description": "系统标识信息",
            "root": {
              "_description": "固定值，标识ID类型为系统标识",
              "_value": "2.16.156.10011.2.5.1.3"
            },
            "extension": {
              "_description": "发送系统的唯一标识编码"
            }
          }
        }
      }
    }
  },
  "controlActProcess": {
    "_description": "控制活动过程，包含注册请求的主体内容",
    "classCode": {
      "_description": "固定值",
      "_value": "CACT"
    },
    "moodCode": {
      "_description": "固定值，表示事件",
      "_value": "EVN"
    },
    "subject": {
      "_description": "主题信息",
      "typeCode": {
        "_description": "固定值",
        "_value": "SUBJ"
      },
      "registrationRequest": {
        "_description": "注册请求信息",
        "classCode": {
          "_description": "固定值，表示注册",
          "_value": "REG"
        },
        "moodCode": {
          "_description": "固定值，表示请求",
          "_value": "RQO"
        },
        "statusCode": {
          "_description": "状态码"
        },
        "subject1": {
          "_description": "值集注册信息，subject1为1..*",
          "_cardinality": "1..*",
          "_required": true,
          "typeCode": {
            "_description": "固定值",
            "_value": "SBJ"
          },
          "valueSet": {
            "_description": "值集信息",
            "id": {
              "_description": "值集标识符",
              "_cardinality": "1..1",
              "_required": true,
              "_format": "字符串，最大长度50"
            },
            "desc": {
              "_description": "值集描述",
              "_cardinality": "1..1",
              "_required": true,
              "_format": "字符串，最大长度100"
            },
            "statusCode": {
              "_description": "值集状态代码",
              "_cardinality": "0..1",
              "_required": false,
              "_format": "字符串，最大长度50"
            },
            "version": {
              "_description": "值集版本信息",
              "_cardinality": "0..1",
              "_required": false,
              "code": {
                "_description": "版本代码",
                "_format": "字符串，最大长度50"
              },
              "displayName": {
                "_description": "版本描述",
                "_format": "字符串，最大长度100"
              }
            },
            "valueSetItems": {
              "_description": "值集项目内容",
              "_cardinality": "0..*",
              "_required": false,
              "code": {
                "_description": "项目代码",
                "_cardinality": "1..1",
                "_required": true,
                "_format": "字符串，最大长度50"
              },
              "displayName": {
                "_description": "项目描述",
                "_cardinality": "1..1",
                "_required": true,
                "_format": "字符串，最大长度100"
              },
              "statusCode": {
                "_description": "项目状态代码",
                "_cardinality": "0..1",
                "_required": false,
                "_format": "字符串，最大长度50"
              }
            }
          }
        },
        "author": {
          "_description": "值集注册者信息",
          "typeCode": {
            "_description": "固定值",
            "_value": "AUT"
          },
          "assignedEntity": {
            "_description": "注册者信息",
            "classCode": {
              "_description": "固定值",
              "_value": "ASSIGNED"
            },
            "id": {
              "_description": "注册者工号",
              "_cardinality": "1..1",
              "_required": true,
              "_format": "字符串，最大长度50",
              "item": {
                "root": {
                  "_description": "固定值，标识ID类型为注册者工号",
                  "_value": "2.16.156.10011.1.4"
                },
                "extension": {
                  "_description": "注册者工号的具体值"
                }
              }
            },
            "assignedPerson": {
              "_description": "注册者个人信息",
              "classCode": {
                "_description": "固定值",
                "_value": "PSN"
              },
              "determinerCode": {
                "_description": "固定值",
                "_value": "INSTANCE"
              },
              "name": {
                "_description": "注册者姓名",
                "_dataElement": "DE02.01.039.00",
                "_type": "姓名列表",
                "item": {
                  "part": {
                    "_description": "姓名部分",
                    "value": {
                      "_description": "注册者姓名"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
