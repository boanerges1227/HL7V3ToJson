                }
              },
              {
                "_description": "地址-乡（镇、街道办事处）",
                "type": {
                  "_value": "STB"
                },
                "value": {
                  "_description": "乡镇",
                  "_dataElement": "DE02.01.094.00"
                }
              },
              {
                "_description": "地址-村（街、路、弄等）",
                "type": {
                  "_value": "STR"
                },
                "value": {
                  "_description": "街道",
                  "_dataElement": "DE02.01.095.00"
                }
              },
              {
                "_description": "地址-门牌号码",
                "type": {
                  "_value": "BNR"
                },
                "value": {
                  "_description": "门牌号",
                  "_dataElement": "DE02.01.096.00"
                }
              },
              {
                "_description": "邮政编码",
                "type": {
                  "_value": "ZIP"
                },
                "value": {
                  "_description": "邮编",
                  "_dataElement": "DE02.01.047.00"
                }
              }
            ]
          }
        },
        "maritalStatusCode": {
          "_description": "婚姻状况信息",
          "_cardinality": "0..1",
          "_required": false,
          "_dataElement": "DE02.01.018.00",
