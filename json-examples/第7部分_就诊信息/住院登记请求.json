          "1": "自费",
          "2": "医保",
          "3": "公费"
        }
      }
    },
    "diagnosis": {
      "_description": "入院诊断信息",
      "_cardinality": "0..*",
      "_required": false,
      "code": {
        "_description": "诊断编码",
        "_dataElement": "DE05.01.025.00"
      },
      "displayName": {
