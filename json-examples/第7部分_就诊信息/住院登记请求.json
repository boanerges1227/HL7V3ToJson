    },
    "patientType": {
      "_description": "患者类型",
      "_dataElement": "DE02.01.060.00",
      "code": {
        "_description": "患者类型代码",
        "_codeSystem": "2.16.156.10011.2.3.1.271"
      },
      "displayName": {
        "_description": "患者类型名称",
