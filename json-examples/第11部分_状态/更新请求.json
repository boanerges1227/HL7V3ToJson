{
  "messageHeader": {
    "_description": "消息头信息，所有消息类型的公共部分",
    "id": {
      "_description": "消息流水号，唯一标识本条消息",
      "_cardinality": "1..1",
      "_required": true,
      "_format": "字符串，最大长度50",
      "_example": "22a0f9e0-4454-11dc-a6be-3603d6866807",
      "root": {
        "_description": "固定值，标识ID类型为消息流水号",
        "_value": "2.16.156.10011.2.5.1.1"
      },
      "extension": {
        "_description": "消息流水号的具体值"
      }
    },
    "creationTime": {
      "_description": "消息创建时间",
      "_cardinality": "1..1",
      "_required": true,
      "_format": "yyyyMMddHHmmss",
      "_example": "20070803130624"
    },
    "interactionId": {
      "_description": "消息服务标识，标识本消息对应哪个服务接口",
      "_cardinality": "1..1",
      "_required": true,
      "root": {
        "_description": "固定值，标识ID类型为消息服务标识",
        "_value": "2.16.156.10011.2.5.1.2"
      },
      "extension": {
        "_description": "固定值 POOR_IN200920UV 表示状态更新请求消息，用于更新业务对象的状态信息",
        "_fixedValue": "POOR_IN200920UV"
      }
    },
    "processingCode": {
      "_description": "处理代码，标识此消息属于哪种系统环境",
      "_cardinality": "1..1",
      "_required": true,
      "_allowedValues": {
        "D": "调试系统（Debug）",
        "P": "产品系统（Production）",
        "T": "训练系统（Training）"
      }
    },
    "processingModeCode": {
      "_description": "处理模式代码"
    },
    "acceptAckCode": {
      "_description": "消息应答控制码，标识接收方是否需要返回应答",
      "_cardinality": "1..1",
      "_required": true,
      "_allowedValues": {
        "AL": "总是返回应答（Always）",
        "ER": "仅在错误时返回应答（Error/reject only）",
        "NE": "从不返回应答（Never）"
      }
    },
    "receiver": {
      "_description": "接收者信息，标识消息的目标系统",
      "_cardinality": "1..1",
      "_required": true,
      "_attributes": {
        "typeCode": "RCV"
      },
      "device": {
        "_description": "接收设备/系统信息",
        "id": {
          "_description": "接收系统标识",
          "item": {
            "_description": "系统标识信息",
            "root": {
              "_description": "固定值，标识ID类型为系统标识",
              "_value": "2.16.156.10011.2.5.1.3"
            },
            "extension": {
              "_description": "接收系统的唯一标识编码"
            }
          }
        },
        "telecom": {
          "_description": "接收系统通信地址"
        }
      }
    },
    "sender": {
      "_description": "发送者信息，标识消息的来源系统",
      "_cardinality": "1..1",
      "_required": true,
      "_attributes": {
        "typeCode": "SND"
      },
      "device": {
        "_description": "发送设备/系统信息",
        "id": {
          "_description": "发送系统标识",
          "item": {
            "_description": "系统标识信息",
            "root": {
              "_description": "固定值，标识ID类型为系统标识",
              "_value": "2.16.156.10011.2.5.1.3"
            },
            "extension": {
              "_description": "发送系统的唯一标识编码"
            }
          }
        },
        "telecom": {
          "_description": "发送系统通信地址"
        }
      }
    }
  },
  "statusUpdate": {
    "_description": "状态更新信息主体",
    "id": {
      "_description": "更新请求流水号",
      "_cardinality": "1..1",
      "_required": true,
      "root": {
        "_value": "2.16.156.10011.2.5.1.1"
      },
      "extension": {
        "_description": "更新请求流水号值"
      }
    },
    "statusCode": {
      "_description": "目标状态码",
      "_cardinality": "1..1",
      "_required": true
    },
    "target": {
      "_description": "目标对象信息",
      "_cardinality": "1..1",
      "_required": true,
      "id": {
        "_description": "目标对象标识",
        "_cardinality": "1..1",
        "_required": true,
        "root": {
          "_description": "目标对象标识类型"
        },
        "extension": {
          "_description": "目标对象标识值"
        }
      },
      "typeCode": {
        "_description": "目标对象类型代码"
      }
    },
    "effectiveTime": {
      "_description": "生效时间",
      "_cardinality": "0..1",
      "_required": false
    },
    "actor": {
      "_description": "操作者信息",
      "_cardinality": "0..1",
      "_required": false,
      "id": {
        "_description": "操作者标识",
        "item": {
          "root": {
            "_value": "2.16.156.10011.1.4"
          },
          "extension": {
            "_description": "操作者工号"
          }
        }
      },
      "person": {
        "_description": "操作者个人信息",
        "name": {
          "_description": "操作者姓名"
        }
      }
    },
    "annotation": {
      "_description": "备注信息",
      "_cardinality": "0..1",
      "_required": false,
      "text": {
        "_description": "备注内容"
      }
    }
  }
}