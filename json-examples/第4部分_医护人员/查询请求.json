{
  "messageHeader": {
    "_description": "消息头信息，所有消息类型的公共部分",
    "id": {
      "_description": "消息流水号，唯一标识本条消息",
      "_cardinality": "1..1",
      "_required": true,
      "_format": "字符串，最大长度50",
      "root": {
        "_description": "固定值，标识ID类型为消息流水号",
        "_value": "2.16.156.10011.2.5.1.1"
      },
      "extension": {
        "_description": "消息流水号的具体值，由发送方生成的唯一标识",
        "_example": "9D73520B-D489-4B70-8F4B-7B5C2D7961B5"
      }
    },
    "creationTime": {
      "_description": "消息创建时间，标识消息何时生成",
      "_cardinality": "1..1",
      "_required": true,
      "_format": "日期时间格式，yyyyMMddHHmmss（DT15）",
      "_example": "20130116112855"
    },
    "interactionId": {
      "_description": "消息服务标识，标识本消息对应哪个服务接口",
      "_cardinality": "1..1",
      "_required": true,
      "root": {
        "_description": "固定值，标识ID类型为消息服务标识",
        "_value": "2.16.156.10011.2.5.1.2"
      },
      "extension": {
        "_description": "服务标识代码",
        "_allowedValues": [
          "PRPM_IN301010UV01 - 医疗卫生人员信息注册请求",
          "PRPM_IN303010UV01 - 医疗卫生人员信息更新请求",
          "PRPM_IN306010UV01 - 医疗卫生人员信息查询请求",
          "PRPM_IN306011UV01 - 医疗卫生人员信息查询响应",
          "MCCI_IN000002UV01 - 通用应答消息"
        ]
      }
    },
    "processingCode": {
      "_description": "处理代码，标识此消息属于哪种系统环境",
      "_cardinality": "1..1",
      "_required": true,
      "_allowedValues": {
        "D": "调试系统（Debug）",
        "P": "产品系统（Production）",
        "T": "训练系统（Training）"
      }
    },
    "acceptAckCode": {
      "_description": "消息应答控制码，标识接收方是否需要返回应答",
      "_cardinality": "1..1",
      "_required": true,
      "_allowedValues": {
        "AL": "总是返回应答（Always）",
        "ER": "仅在错误时返回应答（Error/reject only）",
        "NE": "从不返回应答（Never）"
      }
    },
    "receiver": {
      "_description": "接收者信息，标识消息的目标系统",
      "_cardinality": "1..1",
      "_required": true,
      "device": {
        "_description": "接收设备/系统信息",
        "id": {
          "_description": "接收系统标识",
          "item": {
            "_description": "系统标识信息",
            "root": {
              "_description": "固定值，标识ID类型为系统标识",
              "_value": "2.16.156.10011.2.5.1.3"
            },
            "extension": {
              "_description": "接收系统的唯一标识编码"
            }
          }
        }
      }
    },
    "sender": {
      "_description": "发送者信息，标识消息的来源系统",
      "_cardinality": "1..1",
      "_required": true,
      "device": {
        "_description": "发送设备/系统信息",
        "id": {
          "_description": "发送系统标识",
          "item": {
            "_description": "系统标识信息",
            "root": {
              "_description": "固定值，标识ID类型为系统标识",
              "_value": "2.16.156.10011.2.5.1.3"
            },
            "extension": {
              "_description": "发送系统的唯一标识编码"
            }
          }
        }
      }
    }
  },
  "controlActProcess": {
    "_description": "业务控制信息，包含查询请求的主体内容",
    "queryByParameterPayload": {
      "_description": "查询参数",
      "statusCode": {
        "_description": "查询状态",
        "_allowedValues": {
          "new": "新建查询"
        }
      },
      "administrativeGender": {
        "_description": "性别查询条件",
        "_cardinality": "0..1",
        "_required": false,
        "value": {
          "_description": "性别信息",
          "code": {
            "_description": "性别代码",
            "_dataElement": "DE02.01.040.00"
          },
          "codeSystem": {
            "_description": "固定值，性别代码表",
            "_value": "2.16.156.10011.2.3.3.4"
          },
          "displayName": {
            "_description": "性别描述，如：男性、女性"
          }
        }
      },
      "dOB": {
        "_description": "出生日期查询条件",
        "_cardinality": "0..1",
        "_required": false,
        "value": {
          "_description": "出生日期范围",
          "low": {
            "_description": "出生日期下限",
            "_format": "yyyyMMddHHmmss"
          },
          "high": {
            "_description": "出生日期上限",
            "_format": "yyyyMMddHHmmss"
          }
        }
      },
      "providerID": {
        "_description": "医疗卫生人员标识查询条件",
        "_cardinality": "0..1",
        "_required": false,
        "value": [
          {
            "_description": "医疗卫生人员工号",
            "root": {
              "_description": "固定值，标识ID类型为医疗卫生人员工号",
              "_value": "2.16.156.10011.1.4"
            },
            "extension": {
              "_description": "医疗卫生人员工号的具体值"
            }
          },
          {
            "_description": "身份证件号码",
            "root": {
              "_description": "固定值，标识ID类型为身份证件号码",
              "_value": "2.16.156.10011.1.3"
            },
            "extension": {
              "_description": "身份证件号码的具体值"
            }
          }
        ]
      },
      "providerName": {
        "_description": "医疗卫生人员姓名查询条件",
        "_cardinality": "0..1",
        "_required": false,
        "value": {
          "_description": "姓名信息",
          "part": {
            "_description": "姓名值"
          }
        }
      }
    }
  }
}