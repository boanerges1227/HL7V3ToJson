{
  "messageHeader": {
    "_description": "消息头信息，所有消息类型的公共部分",
    "id": {
      "_description": "消息流水号，唯一标识本条消息",
      "_cardinality": "1..1",
      "_required": true,
      "_format": "字符串，最大长度50",
      "_example": "22a0f9e0-4454-11dc-a6be-3603d6866807",
      "root": {
        "_description": "固定值，标识ID类型为消息流水号",
        "_value": "2.16.156.10011.2.5.1.1"
      },
      "extension": {
        "_description": "消息流水号的具体值"
      }
    },
    "creationTime": {
      "_description": "消息创建时间",
      "_cardinality": "1..1",
      "_required": true,
      "_format": "yyyyMMddHHmmss",
      "_example": "20070803130624"
    },
    "interactionId": {
      "_description": "消息服务标识，标识本消息对应哪个服务接口",
      "_cardinality": "1..1",
      "_required": true,
      "root": {
        "_description": "固定值，标识ID类型为消息服务标识",
        "_value": "2.16.156.10011.2.5.1.2"
      },
      "extension": {
        "_description": "固定值 POOR_IN200910UV 表示预约申请请求消息，用于向医院信息平台提交预约申请",
        "_fixedValue": "POOR_IN200910UV"
      }
    },
    "processingCode": {
      "_description": "处理代码，标识此消息属于哪种系统环境",
      "_cardinality": "1..1",
      "_required": true,
      "_allowedValues": {
        "D": "调试系统（Debug）",
        "P": "产品系统（Production）",
        "T": "训练系统（Training）"
      }
    },
    "processingModeCode": {
      "_description": "处理模式代码"
    },
    "acceptAckCode": {
      "_description": "消息应答控制码，标识接收方是否需要返回应答",
      "_cardinality": "1..1",
      "_required": true,
      "_allowedValues": {
        "AL": "总是返回应答（Always）",
        "ER": "仅在错误时返回应答（Error/reject only）",
        "NE": "从不返回应答（Never）"
      }
    },
    "receiver": {
      "_description": "接收者信息，标识消息的目标系统",
      "_cardinality": "1..1",
      "_required": true,
      "_attributes": {
        "typeCode": "RCV"
      },
      "device": {
        "_description": "接收设备/系统信息",
        "id": {
          "_description": "接收系统标识",
          "item": {
            "_description": "系统标识信息",
            "root": {
              "_description": "固定值，标识ID类型为系统标识",
              "_value": "2.16.156.10011.2.5.1.3"
            },
            "extension": {
              "_description": "接收系统的唯一标识编码"
            }
          }
        },
        "telecom": {
          "_description": "接收系统通信地址"
        }
      }
    },
    "sender": {
      "_description": "发送者信息，标识消息的来源系统",
      "_cardinality": "1..1",
      "_required": true,
      "_attributes": {
        "typeCode": "SND"
      },
      "device": {
        "_description": "发送设备/系统信息",
        "id": {
          "_description": "发送系统标识",
          "item": {
            "_description": "系统标识信息",
            "root": {
              "_description": "固定值，标识ID类型为系统标识",
              "_value": "2.16.156.10011.2.5.1.3"
            },
            "extension": {
              "_description": "发送系统的唯一标识编码"
            }
          }
        },
        "telecom": {
          "_description": "发送系统通信地址"
        }
      }
    }
  },
  "appointment": {
    "_description": "预约申请信息主体",
    "id": {
      "_description": "预约流水号，由申请方生成",
      "_cardinality": "1..1",
      "_required": true,
      "_format": "字符串，最大长度50",
      "_dataElement": "预约流水号",
      "root": {
        "_value": "2.16.156.10011.1.30"
      },
      "extension": {
        "_description": "预约流水号的具体值"
      }
    },
    "statusCode": {
      "_description": "预约状态码",
      "_cardinality": "1..1",
      "_required": true,
      "_allowedValues": {
        "active": "有效",
        "completed": "已完成",
        "cancelled": "已取消"
      }
    },
    "effectiveTime": {
      "_description": "预约有效时间",
      "_cardinality": "0..1",
      "_required": false,
      "low": {
        "_description": "预约开始时间"
      },
      "high": {
        "_description": "预约结束时间"
      }
    },
    "appointmentReasonCode": {
      "_description": "预约原因编码",
      "_cardinality": "0..1",
      "_required": false,
      "codeSystem": {
        "_value": "2.16.156.10011.2.3.1.268"
      },
      "displayName": {
        "_description": "预约原因名称"
      }
    },
    "patient": {
      "_description": "患者信息",
      "_cardinality": "1..1",
      "_required": true,
      "id": {
        "_description": "患者标识列表",
        "_cardinality": "1..*",
        "_required": true,
        "item": [
          {
            "_description": "患者编号（必填）",
            "root": {
              "_value": "2.16.156.10011.2.5.1.4"
            },
            "extension": {
              "_description": "患者编号值"
            }
          },
          {
            "_description": "门（急）诊号",
            "root": {
              "_value": "2.16.156.10011.1.10"
            },
            "extension": {
              "_description": "门（急）诊号值"
            }
          }
        ]
      },
      "person": {
        "_description": "患者个人信息",
        "name": {
          "_description": "患者姓名",
          "_dataElement": "DE02.01.039.01"
        },
        "gender": {
          "_description": "患者性别",
          "_dataElement": "DE02.01.040.00",
          "_codeSystem": "2.16.156.10011.2.3.3.4"
        },
        "birthTime": {
          "_description": "患者出生日期",
          "_dataElement": "DE02.01.005.00",
          "_format": "yyyyMMdd"
        }
      },
      "telecom": {
        "_description": "患者联系电话",
        "_dataElement": "DE02.01.010.05"
      }
    },
    "service": {
      "_description": "预约服务信息",
      "_cardinality": "1..1",
      "_required": true,
      "code": {
        "_description": "预约服务类型编码",
        "codeSystem": {
          "_value": "2.16.156.10011.2.3.1.268"
        },
        "displayName": {
          "_description": "预约服务类型名称，如：门诊预约、检查预约等"
        }
      },
      "provider": {
        "_description": "服务提供方信息",
        "organization": {
          "_description": "医疗机构信息",
          "id": {
            "_description": "医疗机构编码",
            "item": {
              "root": {
                "_value": "2.16.156.10011.1.19"
              },
              "extension": {
                "_description": "医疗机构编码值"
              }
            }
          },
          "name": {
            "_description": "医疗机构名称"
          }
        },
        "serviceLocation": {
          "_description": "服务地点信息",
          "id": {
            "_description": "科室编码",
            "item": {
              "root": {
                "_value": "2.16.156.10011.1.26"
              },
              "extension": {
                "_description": "科室编码值"
              }
            }
          },
          "name": {
            "_description": "科室名称"
          }
        },
        "serviceProvider": {
          "_description": "服务提供者（医生）信息",
          "id": {
            "_description": "医生工号",
