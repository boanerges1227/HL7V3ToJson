              "root": {
                "_value": "2.16.156.10011.1.4"
              },
              "extension": {
                "_description": "医生工号值"
              }
            }
          },
          "person": {
            "_description": "医生个人信息",
            "name": {
              "_description": "医生姓名"
            }
          }
        }
      }
    },
    "slot": {
      "_description": "预约时间段信息",
      "_cardinality": "1..1",
      "_required": true,
      "id": {
        "_description": "时间段标识"
      },
      "statusCode": {
        "_description": "时间段状态"
      },
      "effectiveTime": {
        "_description": "预约时间",
        "_cardinality": "1..1",
        "_required": true,
        "low": {
          "_description": "预约开始时间"
        },
        "high": {
          "_description": "预约结束时间"
        }
      }
