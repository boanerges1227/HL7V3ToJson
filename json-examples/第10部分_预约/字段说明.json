        {"path": "controlActProcess.queryByParameter.appointmentDate", "name": "预约日期", "type": "date", "required": false, "description": "按预约日期查询"},
        {"path": "controlActProcess.queryByParameter.status", "name": "预约状态", "type": "string", "required": false, "enum": ["active-已预约", "completed-已就诊", "cancelled-已取消"], "description": "按预约状态查询"}
