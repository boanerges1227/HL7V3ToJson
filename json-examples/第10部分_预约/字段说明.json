        {"path": "controlActProcess.subject.appointment.doctorName", "name": "医生姓名", "type": "string", "required": false, "description": "指定医生姓名"},
        {"path": "controlActProcess.subject.appointment.appointmentDate", "name": "预约日期", "type": "date", "required": true, "format": "yyyyMMdd", "description": "预约就诊日期"},
        {"path": "controlActProcess.subject.appointment.appointmentTime", "name": "预约时段", "type": "string", "required": true, "enum": ["上午", "下午", "晚间"], "description": "预约时段"},
        {"path": "controlActProcess.subject.appointment.visitType", "name": "就诊类型", "type": "string", "required": true, "enum": ["普通门诊", "专家门诊", "特需门诊"], "description": "门诊类型"},
        {"path": "controlActProcess.subject.appointment.contactPhone", "name": "联系电话", "type": "string", "required": true, "dataElement": "DE02.01.010.05", "description": "患者联系电话"},
